/*
 * SoC-side board fixups for the ZCU102 (ZynqMP), layered on top of the
 * gen-machineconf / lopper-generated cortexa53-linux.dts (which carries the PS
 * config and the PL AXI Ethernet cores from the XSA). Scoped to the Linux
 * domain by device-tree.bbappend. The external Ethernet PHY wiring is supplied
 * by the bsp/port-configs overlay (port-config.dtsi): ports-0123 for
 * zcu102_hpc0 (4 ports) and ports-01-- for zcu102_hpc1 (2 ports).
 *
 * UART: ZCU102's CP2108 bridge exposes both PSU_UART_0 and PSU_UART_1 on USB.
 * 2025.2's gen-machineconf assigns port-number=0 to uart1, making ttyPS0 map to
 * uart1. Our test/logging setup is cabled to the UART_0 CP2108 interface, so
 * force ttyPS0 back to uart0.
 */

&uart0 {
	port-number = <0>;
};
&uart1 {
	port-number = <1>;
};

/ {
	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};
	chosen {
		stdout-path = "serial0:115200n8";
	};
};

/* PS GEM3 (board RJ45): the SDT flow does not describe the board-level
 * TI DP83867 PHY, so Linux falls back to the Generic PHY driver and the
 * RGMII clock delays are never programmed - the link negotiates 1G but
 * passes no packets. The ZCU102 PHY address depends on the board
 * revision (revA: 21, revB/rev1.0/rev1.1: 0xc), so both subnodes are
 * described and no phy-handle is set: macb scans the MDIO bus and binds
 * the address that answers, picking up that node's delay properties.
 * Values from the official zynqmp-zcu102-rev*.dts. The fixed MAC
 * replaces the random one the SDT flow leaves us with.
 */
&gem3 {
	local-mac-address = [00 0a 35 06 21 02];
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet-phy@c {
			compatible = "ethernet-phy-id2000.a231";
			reg = <0xc>;
			ti,rx-internal-delay = <0x8>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
		ethernet-phy@21 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <21>;
			ti,rx-internal-delay = <0x8>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
	};
};
